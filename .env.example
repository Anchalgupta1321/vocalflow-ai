# Multi-Tenant AI Phone Receptionist SaaS Environment Configuration

# Application Mode & Port
PORT=4000
NODE_ENV=production

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/vocalflow_db?schema=public"

# ElevenLabs Conversational Voice API
ELEVENLABS_API_KEY="el_live_your_elevenlabs_api_key_here"
ELEVENLABS_DEFAULT_AGENT_ID="agent_your_agent_id"

# Cartesia Sonic Voice API (Low Latency Engine)
CARTESIA_API_KEY="cartesia_your_api_key_here"

# Indian Telephony Provider Credentials (Exotel / Twilio India / Tata Tele)
TELEPHONY_PROVIDER="exotel"
EXOTEL_ACCOUNT_SID="exotel_sub_account_sid"
EXOTEL_API_KEY="exotel_api_key"
EXOTEL_API_TOKEN="exotel_api_token"
EXOTEL_SUBDOMAIN="api.exotel.com"

# TRAI DLT Principal Entity Registration
TRAI_DLT_ENTITY_ID="PE-10029384-TRAI"
TRAI_DLT_DEFAULT_HEADER="AD-APOLLO"

# Meta WhatsApp Cloud API Integration
WHATSAPP_CLOUD_API_TOKEN="EAAG_your_meta_system_user_token"
WHATSAPP_PHONE_NUMBER_ID="10029384729384"

# Razorpay Subscriptions & Metered Billing
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
